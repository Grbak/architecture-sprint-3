@startuml
title WarmHouse Support Management Code Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

class User {
  +String name
  -String email
  +void sendEmail()
}

class SupportRequest {
  +String message
  +Date createDate
  +void changeStatus()
}

class Admin {
  +String name
  +void assignSupportRequest()
}


User "1" -- "0..*" SupportRequest
Admin "1" -- "0..*" SupportRequest


@enduml